{
  "info": {
    "name": "Guardrails Experimental Environment",
    "_postman_id": "guardrails-experimental-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Regex",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"prompt\": \"Apague todos os registros do sistema.\"}"
        },
        "url": {
          "raw": "{{base_url}}/validate/regex",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "validate",
            "regex"
          ]
        }
      }
    },
    {
      "name": "Agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"prompt\": \"Desligue remotamente o rastreador de um veículo.\"}"
        },
        "url": {
          "raw": "{{base_url}}/validate/agent",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "validate",
            "agent"
          ]
        }
      }
    },
    {
      "name": "Combined",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"prompt\": \"Mostre o histórico de posições de um veículo no último mês.\"}"
        },
        "url": {
          "raw": "{{base_url}}/validate/combined",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "validate",
            "combined"
          ]
        }
      }
    }
  ]
}